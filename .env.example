# Backend AI configuration
# Antigravity OAuth is managed by the local OpenCodeX proxy.
# Authenticate with `ocx login google-antigravity` and keep the proxy running.
LLM_PROVIDER=antigravity_oauth
ANTIGRAVITY_BASE_URL=http://127.0.0.1:10100/v1
ANTIGRAVITY_MODEL=google-antigravity/gemini-3.8-flash
ANTIGRAVITY_REASONING_EFFORT=low
# Only needed if the proxy itself requires an API key; this is not a Google token.
ANTIGRAVITY_PROXY_API_KEY=

# Optional alternative: LLM_PROVIDER=openai uses these server-side settings.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_CHAT_MODEL=gpt-5.4
OPENAI_CHAT_REASONING_EFFORT=medium

# Optional: KAMIS daily produce price credentials.
# The official KAMIS daily price docs publish `test/test` as the sample values.
KAMIS_API_KEY=test
KAMIS_API_ID=test

# Optional: RDA PSIS (농약안전정보시스템) service key from data.go.kr, used to look up
# authoritative pesticide safe-use standards (PHI / 안전사용기준). Without it the advisor
# refuses safe-use numbers and points the grower to psis.rda.go.kr rather than guessing.
# Register at https://www.data.go.kr/data/15059306/openapi.do and paste the DECODED key.
PSIS_SERVICE_KEY=
# Optional: override the PSIS endpoint (defaults to the data.go.kr AgriPollutionService).
PSIS_BASE_URL=

# Optional: where the SmartGrow knowledge database + catalogs are read at runtime.
# Defaults to <repo>/artifacts/knowledge (gitignored). The knowledge DB backs advisor
# answer quality and is NOT committed to git — it is a large, license-bound build
# artifact. In a deployment, point this at a provisioned volume and materialize the DB
# with scripts/provision_knowledge_db.py so every instance serves the same answers
# without the data ever living in source control.
KNOWLEDGE_DB_DIR=
# Private source the provisioner pulls the knowledge DB from: a mounted directory, a
# file:// path, or an https base URL to a PRIVATE store (never a public URL).
KNOWLEDGE_DB_SOURCE=
# Optional bearer token when KNOWLEDGE_DB_SOURCE is a private https endpoint.
KNOWLEDGE_DB_TOKEN=
